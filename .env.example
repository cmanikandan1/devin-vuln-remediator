# ============================================================
#  devin-vuln-remediator — environment configuration
# ============================================================
# Copy this to `.env` and fill in real values. Never commit `.env`.

# ───── Devin v3 API ─────
# Service user key (starts with cog_). Create at:
#   Devin UI → Settings → Service Users → New service user
DEVIN_API_KEY=

# Organization ID. Find at:
#   Devin UI → Settings → Service Users (top of page)
DEVIN_ORG_ID=

# ───── GitHub ─────
# Fine-grained PAT scoped to your fork, with Issues: Read & Write
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
GITHUB_OWNER=cmanikandan1
GITHUB_REPO=superset

# ───── Webhook signing secret ─────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Must match the secret you configure in GitHub webhook settings.
# Leave empty to skip signature verification (local dev only).
GITHUB_WEBHOOK_SECRET=

# ───── Pipeline config ─────
TRIGGER_LABEL=vuln-auto-remediate
